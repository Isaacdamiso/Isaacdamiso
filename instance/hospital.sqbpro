<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="hospital.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached><db schema="hospital" path="/home/isaac/Desktop/hospital information management system/instance/hospital.db"/></attached><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="599"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/><expanded_item id="4" parent="1"/></tab_structure><tab_browse><table title=".Browsables" custom_title="0" dock_id="1" table="0,10:Browsables"/><dock_state state="000000ff00000000fd0000000100000002000003ef00000240fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003ef0000011200ffffff000002880000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">USE hospital_management_system;
CREATE TABLE docters(
    id INTEGER NOT NULL GENERATED ALWAYS AS IDENTITY,
    column1 VARCHAR(255) NOT NULL,
    column2 TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id)
);
CREATE TABLE patients(
    id INTEGER NOT NULL GENERATED ALWAYS AS IDENTITY,
    column1 VARCHAR(255) NOT NULL,
    column2 TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id)
);
CREATE TABLE appointments(
    id INTEGER NOT NULL GENERATED ALWAYS AS IDENTITY,
    column1 VARCHAR(255) NOT NULL,
    column2 TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    FOREIGN KEY (column1) REFERENCES docters(column1),
    FOREIGN KEY (column1) REFERENCES patients(column1),
);
CREATE TABLE schedules(
    id INTEGER NOT NULL GENERATED ALWAYS AS IDENTITY,
    column1 VARCHAR(255) NOT NULL,
    column2 TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id)
);
-- </sql><current_tab id="0"/></tab_sql></sqlb_project>
